    enum MessageType {
        AODVV2_TYPE_RREQ = 10
        AODVV2_TYPE_RREP = 11
        AODVV2_TYPE_RERR = 12
        AODVV2_TYPE_RREP_ACK = 13
    }

    enum MessageTlvType {
        AODVV2_ACK_REQ = 128
    }

    enum AddressTlvType {
        AODVV2_PATH_METRIC = 129
        AODVV2_SEQ_NUM = 130
        AODVV2_ADDRESS_TYPE = 131
    }

    enum AddressTlvValue {
        AODVV2_ORIGPREFIX = 0
        AODVV2_TARGPREFIX = 1
        AODVV2_UNREACHABLE = 2
        AODVV2_PKTSOURCE = 3
    }

    enum AddressTlvMetricType {
        AODVV2_METRIC_UNASSIGNED = 0
        AODVV2_METRIC_HOP = 1
    }

    RreqHeader ..> PbbPacket : uses
    RrepHeader ..> PbbPacket : uses
    RrepAckHeader ..> PbbPacket : uses
    RerrHeader ..> PbbPacket : uses
