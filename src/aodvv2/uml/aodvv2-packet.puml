    class RerrHeader<T> {
        + RerrHeader()
        + RerrHeader(PbbPacket tlvHeader)
        + static TypeId GetTypeId()
        + void CreateTlvHeader() const
        + void SetTlvHeader(PbbPacket tlvHeader)
