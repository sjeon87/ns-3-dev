        + void Print(std::ostream& os) const
        + void SetRtrIp(T ip)
        + T GetRtrIp() const
        + void SetRtrMask(uint16_t mask)
        + uint16_t GetRtrMask() const
        + void SetOrigIp(T ip)
        + T GetOrigIp() const
        + void SetOrigMask(uint16_t mask)
        + uint16_t GetOrigMask() const
        + void SetOrigSeqNo(uint16_t seq)
